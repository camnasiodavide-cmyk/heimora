rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isMember() {
   return request.auth != null
    && exists(/databases/$(database)/documents/members/$(request.auth.uid));
  }

  function isPayload() {
   return request.resource.data.keys().hasOnly(['payload'])
    && request.resource.data.payload is string
    && request.resource.data.payload.size() <= 200000;
  }

  match /members/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
  }

  match /movements/{id} {
   allow read, delete: if isMember();
   allow create, update: if isMember() && isPayload();
  }

  match /condoStatements/{id} {
   allow read: if isMember();
   allow create: if isMember() && isPayload();
  }

  match /privateConfig/{id} {
   allow get: if isMember() && id == 'rate-annuali-2027';
  }
 }
}
